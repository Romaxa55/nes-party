{
  "name": "nes-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Веб-версия NES с игрой на двоих через браузер. Этап 1: бенчмарк ядра эмуляции.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:fourscore": "node --import tsx scripts/fourscore-test.mts",
    "test:bot": "node --import tsx scripts/bot-sim.mts",
    "replay:bot": "node --import tsx scripts/bot-replay.mts"
  },
  "dependencies": {
    "jsnes": "^2.1.0",
    "peerjs": "^1.5.5",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
